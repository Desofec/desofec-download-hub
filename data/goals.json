function renderGoalCards() {
  const grid = document.querySelector('#goal-grid');
  if (!grid) return;

  const cards = goalData.map((goal) => `
    <article class="goal-card">
      <span class="goal-badge">${goal.badge}</span>
      <h3>${goal.name}</h3>
      <p>${goal.description}</p>
      <div class="card-cta">
        <a class="btn btn-secondary" href="./onboarding.html?goal=${goal.id}">Start here</a>
      </div>
    </article>
  `).join('');

  grid.innerHTML = cards;
}

function renderFeatureList() {
  const list = document.querySelector('#home-feature-list');
  if (!list) return;

  const top = [
    { title: 'Learn AI', text: 'Start with beginner-friendly AI workflows and prompt techniques.' },
    { title: 'Build smarter', text: 'Use practical tools to create projects without overwhelm.' },
    { title: 'Find clarity', text: 'Choose a path instead of chasing random tech trends.' }
  ];

  list.innerHTML = top.map((item) => `
    <article class="feature-card">
      <h3>${item.title}</h3>
      <p>${item.text}</p>
    </article>
  `).join('');
}

function renderPathCards() {
  const grid = document.querySelector('#path-grid');
  if (!grid) return;

  const cards = pathData.map((path) => `
    <article class="path-card">
      <div class="card-row">
        <span class="path-badge">${path.badge}</span>
        <span class="skill-chip">${path.level}</span>
      </div>
      <h3>${path.title}</h3>
      <p>${path.description}</p>
      <div class="card-cta">
        <a class="btn btn-secondary" href="./onboarding.html?goal=${path.id}">View path</a>
      </div>
    </article>
  `).join('');

  grid.innerHTML = cards;
}

function renderToolCards() {
