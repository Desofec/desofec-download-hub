<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Desofec Download Hub — curated software, AI, ML, CAD, and creative tools built for faster product creation."
    />
    <meta name="theme-color" content="#0b1020" />
    <title>Desofec Download Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-wrap" aria-label="Desofec home">
          <div class="brand-mark">D</div>
          <div>
            <div class="brand-name">Desofec</div>
            <div class="brand-sub">Download Hub</div>
          </div>
        </div>

        <nav class="topnav" aria-label="Main navigation">
          <a href="#featured">Featured</a>
          <a href="#categories">Categories</a>
          <a href="#collections">Collections</a>
          <a href="#platform">Platform</a>
          <a href="#newsletter">Newsletter</a>
          <a href="dashboard.html">Dashboard</a>
        </nav>

        <a class="ghost-button" href="#categories">Explore tools</a>
      </header>

      <main>
        <section class="hero" id="featured">
          <div class="hero-copy">
            <span class="eyebrow">Curated for creators and builders</span>
            <h1>Find the tools that move your idea forward.</h1>
            <p>
              Desofec Download Hub helps founders, creators, and teams discover the best
              AI, ML, CAD, and creative tools without wasting time on scattered, unreliable sources.
            </p>

            <div class="cta-row">
              <a class="primary-button" href="#categories">Browse catalog</a>
              <a class="secondary-button" href="#platform">See platform</a>
            </div>

            <div class="hero-stats" aria-label="Project statistics">
              <div>
                <strong>120+</strong>
                <span>Curated tools</span>
              </div>
              <div>
                <strong>18</strong>
                <span>Categories</span>
              </div>
              <div>
                <strong>4.9/5</strong>
                <span>Trust rating</span>
              </div>
            </div>
          </div>

          <div class="hero-panel" aria-label="Featured tools panel">
            <div class="panel-header-row">
              <div class="panel-header">
                <span class="status-dot"></span>
                <span>Featured collections</span>
              </div>
              <span class="panel-pill">Updated today</span>
            </div>
            <div class="tool-list">
              <article class="tool-item featured-item">
                <div class="tool-meta">
                  <span class="tag tag-pink">AI</span>
                  <span class="tool-version">v3.0</span>
                </div>
                <h3>Prototype Stack</h3>
                <p>Prompt packs, app scaffolds, and UI flows designed to validate ideas quickly.</p>
                <div class="tool-footer">
                  <span>21k downloads</span>
                  <a href="detail.html?id=prototype-stack">Open</a>
                </div>
              </article>

              <article class="tool-item">
                <div class="tool-meta">
                  <span class="tag tag-blue">Launch</span>
                  <span class="tool-version">v2.1</span>
                </div>
                <h3>Launch Stack</h3>
                <p>Production-ready assets and workflows for teams moving from prototype to launch.</p>
                <div class="tool-footer">
                  <span>12.7k downloads</span>
                  <a href="detail.html?id=launch-stack">Open</a>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="offer-strip" aria-label="Key categories">
          <article class="offer-card offer-ai">
            <span class="offer-icon">✨</span>
            <div>
              <h3>AI Vibe Coding</h3>
              <p>Prompt libraries, AI-first workflows, and no-code-to-code starter packs.</p>
            </div>
          </article>

          <article class="offer-card">
            <span class="offer-icon">🧠</span>
            <div>
              <h3>ML & Data</h3>
              <p>Data prep, model tooling, and deployment-ready machine learning stacks.</p>
            </div>
          </article>

          <article class="offer-card">
            <span class="offer-icon">📐</span>
            <div>
              <h3>CAD & Design</h3>
              <p>Modeling resources, product design kits, and creative workflows for builders.</p>
            </div>
          </article>
        </section>

        <section class="searchbar-wrap" aria-label="Tool search and filters">
          <label class="search-field" for="tool-search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 3a7 7 0 015.4 11.9l4.4 4.4 1.4-1.4-4.4-4.4A7 7 0 1110 3zm0 2a5 5 0 100 10 5 5 0 000-10z" />
            </svg>
            <input id="tool-search" type="search" placeholder="Search products, categories, tags, or workflows" />
          </label>

          <div class="filter-chips" aria-label="Categories filter">
            <button class="chip active" type="button" data-filter="all">All</button>
            <button class="chip" type="button" data-filter="prototype">Prototype</button>
            <button class="chip" type="button" data-filter="launch">Launch</button>
            <button class="chip" type="button" data-filter="ml">ML</button>
            <button class="chip" type="button" data-filter="cad">CAD</button>
            <button class="chip" type="button" data-filter="creative">Creative</button>
          </div>
        </section>

        <section class="catalog" id="categories">
          <div class="section-heading">
            <div>
              <span class="eyebrow">Download catalog</span>
              <h2>Built for real work, not clutter.</h2>
            </div>
            <a href="#newsletter">Get updates</a>
          </div>

          <div id="tool-grid" class="catalog-grid"></div>
        </section>

        <section class="collections" id="collections">
          <div class="section-heading">
            <div>
              <span class="eyebrow">Featured collections</span>
              <h2>From idea to launch</h2>
            </div>
          </div>

          <div class="collection-grid">
            <article class="collection-card">
              <span class="collection-icon">⚙️</span>
              <h3>Prototype Lab</h3>
              <p>Concept validation kits for exploring AI-driven app experiences and toolchains.</p>
            </article>

            <article class="collection-card">
              <span class="collection-icon">🚀</span>
              <h3>Launch Engine</h3>
              <p>Assets and processes for shipping polished solutions with better workflow confidence.</p>
            </article>

            <article class="collection-card">
              <span class="collection-icon">✨</span>
              <h3>Creative Systems</h3>
              <p>Design and content toolkits built for product teams, makers, and high-output creators.</p>
            </article>
          </div>
        </section>

        <section class="hub-features" id="platform">
          <div class="section-heading">
            <div>
              <span class="eyebrow">How it works</span>
              <h2>Built to solve real product bottlenecks</h2>
            </div>
          </div>

          <div class="feature-grid">
            <article class="feature-card">
              <h3>1. Discover</h3>
              <p>Browse by theme, skill level, and workflow to find what you need quickly.</p>
            </article>

            <article class="feature-card">
              <h3>2. Compare</h3>
              <p>Understand compatibility, features, and fit before committing to a tool stack.</p>
            </article>

            <article class="feature-card">
              <h3>3. Download</h3>
              <p>Get reliable versions arranged into clear, useful collections built to reduce friction.</p>
            </article>

            <article class="feature-card">
              <h3>4. Build</h3>
              <p>Use starter kits and systems to move from concept to usable product faster.</p>
            </article>
          </div>
        </section>

        <section class="newsletter" id="newsletter">
          <div>
            <span class="eyebrow">Stay in the loop</span>
            <h2>Get new product stacks before they hit the public catalog.</h2>
          </div>

          <form class="newsletter-form" aria-label="Newsletter signup">
            <input type="email" placeholder="Email address" aria-label="Email address" />
            <button type="submit">Subscribe</button>
          </form>
        </section>
      </main>

      <footer class="site-footer">
        <div>© 2026 Desofec</div>
        <div>Discover. Download. Build.</div>
      </footer>
    </div>

    <script src="script.js"></script>
  </body>
</html>
