const query = document.getElementById('tool-search');
const chips = document.querySelectorAll('.chip');
const toolGrid = document.getElementById('tool-grid');
let activeFilter = 'all';
let allTools = DEFAULT_TOOLS;

function renderCard(tool) {
  const article = document.createElement('article');
  article.className = 'download-card';
  article.dataset.category = tool.category;

  article.innerHTML = `
    <div class="card-top">
      <span class="tag tag-${tool.category === 'prototype' ? 'pink' : tool.category === 'launch' ? 'blue' : tool.category === 'ml' ? 'green' : tool.category === 'cad' ? 'orange' : 'purple'}">${tool.tag}</span>
      <span class="card-badge">${tool.status}</span>
    </div>
    <h3>${tool.name}</h3>
    <p>${tool.description}</p>
    <ul>
      <li>${tool.type}</li>
      <li>${tool.platforms.join(' / ')}</li>
      <li>${tool.size}</li>
    </ul>
    <div class="card-actions">
      <button class="favorite-toggle" type="button">Save</button>
      <a class="card-action primary-button" href="detail.html?id=${tool.id}">Open</a>
    </div>
  `;

  const favoriteButton = article.querySelector('.favorite-toggle');
  favoriteButton.addEventListener('click', () => {
    favoriteButton.classList.toggle('is-favorite');
    favoriteButton.textContent = favoriteButton.classList.contains('is-favorite') ? 'Saved' : 'Save';
  });

  return article;
}

function applyFilter() {
  const queryText = query ? query.value.trim().toLowerCase() : '';
  const cards = document.querySelectorAll('.download-card');

  cards.forEach((card) => {
    const category = card.dataset.category;
    const text = card.textContent.toLowerCase();
    const categoryMatch = activeFilter === 'all' || category === activeFilter;
    const searchMatch = !queryText || text.includes(queryText);
    card.style.display = categoryMatch && searchMatch ? '' : 'none';
  });
}

function renderToolGrid() {
  if (!toolGrid) return;

  toolGrid.innerHTML = '';
  allTools.forEach((tool) => toolGrid.appendChild(renderCard(tool)));
  applyFilter();
}

async function loadTools() {
  try {
    const response = await fetch('tools.json', { cache: 'no-store' });
    if (!response.ok) throw new Error('Load failed');
    const data = await response.json();
    if (Array.isArray(data) && data.length) {
      allTools = data;
    }
  } catch (error) {
    allTools = DEFAULT_TOOLS;
  }

  renderToolGrid();
}

if (query) {
  query.addEventListener('input', applyFilter);
}

chips.forEach((chip) => {
  chip.addEventListener('click', () => {
    chips.forEach((item) => item.classList.remove('active'));
    chip.classList.add('active');
    activeFilter = chip.dataset.filter || 'all';
    applyFilter();
  });
});

const newsletterForm = document.querySelector('.newsletter-form');
if (newsletterForm) {
  newsletterForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const button = newsletterForm.querySelector('button');
    const input = newsletterForm.querySelector('input');

    button.textContent = 'Subscribed';
    button.disabled = true;
    input.value = '';
  });
}

